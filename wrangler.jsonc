{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "scrabble-party",
	"main": "worker.ts",
	"compatibility_date": "2024-08-20",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{
				"name": "SCRABBLE_ROOMS",
				"class_name": "ScrabbleDurableObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ScrabbleDurableObject"]
		}
	]
}
